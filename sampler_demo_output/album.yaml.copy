album:
  title: 采样+合成 混编演示
  artist: BloodMusic Engine
  genre: experimental
  year: 2026
  cover: null
instrument_pool:
  name: 真实采样混合乐池
  bpm: 110
  key: C
  scale: major
  global_volume: 0.9
  generation:
    diversity: 0.5
    humanize: true
    seed: 2026
    chord_progression: dreamy
  instruments:
  - name: 真实伴奏采样
    role: chord
    engine: sampler
    sample_path: G:/tools/audio_separator/no_vocals.wav
    volume: 0.75
    pan: -0.1
  - name: 真实人声采样
    role: melody
    engine: sampler
    sample_path: G:/tools/audio_separator/vocals.wav
    volume: 0.65
    pan: 0.15
  - name: 合成鼓组
    role: drum
    engine: noise
    volume: 0.85
    pan: 0.0
  - name: 合成贝斯
    role: bass
    engine: subtractive
    preset: deep_bass
    volume: 0.9
    pan: 0.0
  - name: 合成铺底
    role: pad
    engine: granular
    preset: bright_pad
    volume: 0.45
    pan: 0.3
mix_config:
  clip_mode: soft
  normalize_mode: rms
  rms_target_db: -2.0
  fade_in_ms: 60
  fade_out_ms: 250
  compress: true
  compress_threshold: -18.0
  compress_ratio: 3.0
  low_pass_cutoff: 0
  high_pass_cutoff: 0
separate_mode: manifest
